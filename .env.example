# Supabase — obtenha os valores com `pnpm supabase status` (local)
# ou no painel do projeto (staging/produção). Nunca commitar valores reais.

# URL da API Supabase
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Chave anon/public — segura para o cliente (acesso via RLS)
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — SOMENTE servidor. Nunca expor ao cliente
# nem usar prefixo NUXT_PUBLIC_*.
NUXT_SUPABASE_SERVICE_ROLE_KEY=


