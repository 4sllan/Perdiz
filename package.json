  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
