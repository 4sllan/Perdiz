    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@nuxtjs/i18n": "10.6.0",
    "@playwright/test": "1.64.1",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
